{
  "name": "honestlint",
  "version": "0.3.0",
  "description": "A linter for deceptive UX. Catch dark patterns in your own web app before your users (or regulators) do.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "honestlint": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "readme-image": "node scripts/readme-image.mjs"
  },
  "keywords": [
    "dark-patterns",
    "deceptive-design",
    "ux",
    "linter",
    "accessibility",
    "playwright",
    "ci"
  ],
  "license": "MIT",
  "author": "haritel97 (https://github.com/haritel97)",
  "homepage": "https://github.com/haritel97/honestlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haritel97/honestlint.git"
  },
  "bugs": {
    "url": "https://github.com/haritel97/honestlint/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
